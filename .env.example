# =============================================================================
# toko-ai-microservices — ENV GABUNGAN (root)
# Salin ke `.env` (JANGAN di-commit). Dibaca semua service Go bila dijalankan dari root repo.
# Prioritas: environment proses > <service>/.env > .env (root).
# Tiap service juga punya <service>/.env.example berisi hanya variabel miliknya.
# =============================================================================

# ---- Umum -------------------------------------------------------------------
APP_ENV=development                      # development => log teks; selain itu JSON
# Rahasia bersama antar-service (gateway, catalog, order, ticket, mcp, agent). GANTI di luar demo.
INTERNAL_API_KEY=internal-dev-key-123
UPSTREAM_TIMEOUT_MS=10000

# ---- Port & URL -------------------------------------------------------------
GATEWAY_PORT=8080
CATALOG_PORT=4001
ORDER_PORT=4002
TICKET_PORT=4003
MCP_PORT=5000
AGENT_PORT=8000
FRONTEND_PORT=3000

CATALOG_URL=http://localhost:4001
ORDER_URL=http://localhost:4002
TICKET_URL=http://localhost:4003
MCP_URL=http://localhost:5000/mcp        # dipakai service-agent
MCP_BASE_URL=http://localhost:5000       # dipakai gateway untuk GET /health
AGENT_URL=http://localhost:8000

# ---- Gateway (hanya gateway yang memegang JWT_SECRET) -----------------------
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
AGENT_TIMEOUT_MS=120000

# ---- Database (SQLite, pure-Go) ---------------------------------------------
AUTH_DB_PATH=./data/auth.db
CATALOG_DB_PATH=./data/catalog.db
ORDER_DB_PATH=./data/order.db
TICKET_DB_PATH=./data/ticket.db

# ---- Order ------------------------------------------------------------------
ORDER_PAYMENT_TTL_MINUTES=15

# ---- Gemini: agent (wajib) + embedding catalog/ticket (opsional) ------------
# Tanpa GOOGLE_API_KEY: catalog & ticket tetap hidup (pencarian => keyword_fallback); agent TIDAK bisa start.
GOOGLE_API_KEY=
AGENT_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001     # text-embedding-004 sudah dihentikan Google
EMBEDDING_DIM=768                        # harus sama dengan dimensi keluaran model
EMBEDDING_TIMEOUT_MS=30000
SEMANTIC_MIN_SCORE=0.55                  # ambang cosine; kalibrasi dengan data seed

# ---- MCP (mode stdio dev saja) ----------------------------------------------
MCP_DEV_USER_ID=GUEST
MCP_DEV_USER_ROLE=GUEST

# ---- Frontend ---------------------------------------------------------------
NUXT_PUBLIC_API_BASE=http://localhost:8080
