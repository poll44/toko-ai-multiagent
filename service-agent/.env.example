# service-agent (:8000, Go + Google ADK) — salin ke service-agent/.env
APP_ENV=development
AGENT_PORT=8000

# WAJIB (fail-fast). Kunci Gemini untuk LLM agent.
GOOGLE_API_KEY=
AGENT_MODEL=gemini-flash-lite-latest

# service-mcp (Streamable HTTP) + kunci internal yang dikirim ke MCP dan divalidasi pada request masuk dari Gateway
MCP_URL=http://localhost:5000/mcp
INTERNAL_API_KEY=internal-dev-key-123
