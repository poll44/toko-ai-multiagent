# service-catalog (:4001) — salin ke service-catalog/.env
APP_ENV=development
CATALOG_PORT=4001

# WAJIB. Harus sama dengan nilai di gateway/order/ticket/mcp/agent.
INTERNAL_API_KEY=internal-dev-key-123

CATALOG_DB_PATH=./data/catalog.db

# Pencarian semantik (opsional). Kosong => GET /api/products/semantic-search memakai keyword_fallback.
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001     # text-embedding-004 sudah dihentikan Google
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_MS=30000
SEMANTIC_MIN_SCORE=0.55
