# service-frontend (:3000, Nuxt 3 SPA, ssr:false) — salin ke service-frontend/.env
# Browser memanggil gateway LANGSUNG (lintas-origin; gateway mengizinkan CORS_ORIGIN=http://localhost:3000).
# Nilai ini ikut ter-bundle ke client => JANGAN taruh rahasia di sini.
NUXT_PUBLIC_API_BASE=http://localhost:8080
FRONTEND_PORT=3000
