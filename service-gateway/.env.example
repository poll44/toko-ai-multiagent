# service-gateway (:8080) — salin ke service-gateway/.env
APP_ENV=development
GATEWAY_PORT=8080

# WAJIB. Hanya gateway yang memegang JWT_SECRET (HS256).
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=8h
# WAJIB. Rahasia bersama; disuntik ke header x-internal-api-key pada setiap request proxy.
INTERNAL_API_KEY=internal-dev-key-123

AUTH_DB_PATH=./data/auth.db
CORS_ORIGIN=http://localhost:3000

# Upstream
CATALOG_URL=http://localhost:4001
ORDER_URL=http://localhost:4002
TICKET_URL=http://localhost:4003         # juga melayani /api/knowledge/**
MCP_BASE_URL=http://localhost:5000       # hanya untuk GET /api/dev/health
AGENT_URL=http://localhost:8000

UPSTREAM_TIMEOUT_MS=10000
AGENT_TIMEOUT_MS=120000                  # LLM lambat
