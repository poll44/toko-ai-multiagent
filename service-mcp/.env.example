# service-mcp (:5000, Go) — salin ke service-mcp/.env
APP_ENV=development
MCP_PORT=5000

# WAJIB. Divalidasi dari service-agent DAN dikirim ke catalog/order/ticket.
INTERNAL_API_KEY=internal-dev-key-123

# REST upstream (service Go, path /api/...)
CATALOG_URL=http://localhost:4001
ORDER_URL=http://localhost:4002
TICKET_URL=http://localhost:4003         # juga untuk search_store_policy (/api/knowledge/search)
UPSTREAM_TIMEOUT_MS=10000

# Mode stdio (go run ./service-mcp --stdio; dev saja, dilarang saat APP_ENV=production).
# Transport HTTP membaca identitas dari header x-user-id / x-user-role pada setiap request.
MCP_DEV_USER_ID=GUEST
MCP_DEV_USER_ROLE=GUEST
