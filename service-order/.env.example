# service-order (:4002) — salin ke service-order/.env
APP_ENV=development
ORDER_PORT=4002

# WAJIB. Harus sama dengan service lain.
INTERNAL_API_KEY=internal-dev-key-123

ORDER_DB_PATH=./data/order.db

# Dipanggil untuk pengurangan/pengembalian stok (/internal/stock/*)
CATALOG_URL=http://localhost:4001
UPSTREAM_TIMEOUT_MS=10000

# Batas waktu bayar sebelum PAYMENT_TIMEOUT (menit)
ORDER_PAYMENT_TTL_MINUTES=15
