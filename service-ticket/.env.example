# service-ticket (:4003) — salin ke service-ticket/.env
APP_ENV=development
TICKET_PORT=4003

# WAJIB. Harus sama dengan service lain.
INTERNAL_API_KEY=internal-dev-key-123

TICKET_DB_PATH=./data/ticket.db

# Validasi kepemilikan order saat membuat tiket (default sudah benar untuk lokal).
ORDER_URL=http://localhost:4002
UPSTREAM_TIMEOUT_MS=10000

# Knowledge base / RAG (opsional). Kosong => GET /api/knowledge/search memakai keyword_fallback.
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001     # text-embedding-004 sudah dihentikan Google
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_MS=30000
SEMANTIC_MIN_SCORE=0.55
